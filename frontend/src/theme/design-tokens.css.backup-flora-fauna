/**
 * M3 Expressive Design Tokens - CareerCopilot
 * Aesthetic: Plant-themed, Organic, Professional
 * Based on Figma Design Specifications
 */

:root {
  /* ========================================================================
   * COLOR PALETTE - M3 Expressive (Figma Spec)
   * Primary: Sage Green (Pill indicator, Connect button)
   * Secondary: Soft Coral/Peach (Create button)
   * Tertiary: Lavender/Lilac (Name highlight)
   * Surface: Deep Charcoal (#121212)
   * ======================================================================== */

  /* Primary Tones (Sage Green / Muted Mint) */
  --ref-palette-primary-0: #000000;
  --ref-palette-primary-10: #0F1F0B;
  --ref-palette-primary-20: #1D3314;
  --ref-palette-primary-30: #2D471F;
  --ref-palette-primary-40: #3D5C2A;
  --ref-palette-primary-50: #527542;
  /* Sage Green Base */
  --ref-palette-primary-60: #6B8F5A;
  --ref-palette-primary-70: #85AA73;
  --ref-palette-primary-80: #B4D8AE;
  --ref-palette-primary-90: #BCE0A8;
  --ref-palette-primary-95: #D8F0C4;
  --ref-palette-primary-100: #FFFFFF;

  /* Secondary Tones (Terracotta) */
  --ref-palette-secondary-0: #000000;
  --ref-palette-secondary-10: #2E150F;
  --ref-palette-secondary-20: #4C251C;
  --ref-palette-secondary-30: #6B392B;
  --ref-palette-secondary-40: #8C4C3A;
  --ref-palette-secondary-50: #AD5F4C;
  --ref-palette-secondary-60: #D97C65;
  /* NEW Terracotta Base */
  --ref-palette-secondary-70: #D09376;
  --ref-palette-secondary-80: #E09F7D;
  --ref-palette-secondary-90: #F2D2C4;
  --ref-palette-secondary-95: #F9EBE6;
  --ref-palette-secondary-100: #FFFFFF;

  /* Tertiary Tones (Lavender/Lilac) */
  --ref-palette-tertiary-0: #000000;
  --ref-palette-tertiary-10: #1A0F2E;
  --ref-palette-tertiary-20: #301E4A;
  --ref-palette-tertiary-30: #472F66;
  --ref-palette-tertiary-40: #5E4182;
  --ref-palette-tertiary-50: #8B7AB8;
  /* Wattle Gold Base */
  --ref-palette-tertiary-60: #D9B317;
  --ref-palette-tertiary-70: #E6BD18;
  --ref-palette-tertiary-80: #F0C419;
  --ref-palette-tertiary-90: #FCE68A;
  --ref-palette-tertiary-95: #FEF3C5;
  --ref-palette-tertiary-100: #FFFFFF;

  /* Error Tones */
  --ref-palette-error-0: #000000;
  --ref-palette-error-10: #410E0B;
  --ref-palette-error-20: #601410;
  --ref-palette-error-30: #8C1D18;
  --ref-palette-error-40: #B3261E;
  --ref-palette-error-50: #DC362E;
  --ref-palette-error-60: #E46962;
  --ref-palette-error-70: #EC928E;
  --ref-palette-error-80: #F2B8B5;
  --ref-palette-error-90: #F9DEDC;
  --ref-palette-error-95: #FCEEEE;
  --ref-palette-error-100: #FFFFFF;

  /* Warning Tones (Golden/Amber) */
  --ref-palette-warning-0: #000000;
  --ref-palette-warning-10: #3E2723;
  --ref-palette-warning-20: #5D4037;
  --ref-palette-warning-30: #78350F;
  --ref-palette-warning-40: #F59E0B;
  --ref-palette-warning-50: #FBBF24;
  --ref-palette-warning-60: #FCD34D;
  --ref-palette-warning-70: #FDE68A;
  --ref-palette-warning-80: #FEF3C7;
  --ref-palette-warning-90: #FEF9E7;
  --ref-palette-warning-95: #FFFBF0;
  --ref-palette-warning-100: #FFFFFF;

  /* Neutral Tones (Deep Charcoal/Black) */
  --ref-palette-neutral-0: #000000;
  --ref-palette-neutral-4: #0A0A0A;
  --ref-palette-neutral-6: #121212;
  /* Surface base - Figma spec */
  --ref-palette-neutral-10: #1C1B1F;
  --ref-palette-neutral-12: #1E1E1E;
  --ref-palette-neutral-17: #2B2C30;
  --ref-palette-neutral-22: #303135;
  --ref-palette-neutral-24: #38393E;
  --ref-palette-neutral-30: #484649;
  --ref-palette-neutral-50: #79747E;
  --ref-palette-neutral-70: #AEA9B4;
  --ref-palette-neutral-87: #E0E0E0;
  --ref-palette-neutral-90: #E6E1E5;
  --ref-palette-neutral-95: #F4EFF4;
  --ref-palette-neutral-98: #FDF8FD;
  --ref-palette-neutral-100: #FFFFFF;

  /* System Color Roles (Dark Theme - M3 Expressive) */
  --sys-color-primary: var(--ref-palette-primary-80);
  /* Sage green for pills/buttons */
  --sys-color-on-primary: var(--ref-palette-primary-20);
  --sys-color-primary-container: var(--ref-palette-primary-50);
  --sys-color-on-primary-container: var(--ref-palette-primary-100);

  --sys-color-secondary: var(--ref-palette-secondary-80);
  /* Coral for Create button */
  --sys-color-on-secondary: var(--ref-palette-secondary-20);
  --sys-color-secondary-container: var(--ref-palette-secondary-50);
  --sys-color-on-secondary-container: var(--ref-palette-secondary-100);

  --sys-color-tertiary: var(--ref-palette-tertiary-80);
  /* Lavender for name highlight */
  --sys-color-on-tertiary: var(--ref-palette-tertiary-20);
  --sys-color-tertiary-container: var(--ref-palette-tertiary-50);
  --sys-color-on-tertiary-container: var(--ref-palette-tertiary-100);

  --sys-color-error: var(--ref-palette-error-80);
  --sys-color-on-error: var(--ref-palette-error-20);
  --sys-color-error-container: var(--ref-palette-error-30);
  --sys-color-on-error-container: var(--ref-palette-error-90);

  --sys-color-warning: var(--ref-palette-warning-80);
  --sys-color-on-warning: var(--ref-palette-warning-30);
  --sys-color-warning-container: var(--ref-palette-warning-40);
  --sys-color-on-warning-container: var(--ref-palette-warning-90);

  --sys-color-background: var(--ref-palette-neutral-6);
  --sys-color-on-background: var(--ref-palette-neutral-90);
  --sys-color-surface: var(--ref-palette-neutral-6);
  /* #121212 - Figma spec */
  --sys-color-surface-dim: var(--ref-palette-neutral-6);
  --sys-color-surface-bright: var(--ref-palette-neutral-24);
  --sys-color-surface-container-lowest: var(--ref-palette-neutral-4);
  --sys-color-surface-container-low: var(--ref-palette-neutral-10);
  --sys-color-surface-container: var(--ref-palette-neutral-12);
  --sys-color-surface-container-high: var(--ref-palette-neutral-17);
  --sys-color-surface-container-highest: var(--ref-palette-neutral-22);
  --sys-color-on-surface: var(--ref-palette-neutral-90);
  --sys-color-on-surface-variant: var(--ref-palette-neutral-70);
  --sys-color-outline: var(--ref-palette-neutral-50);
  --sys-color-outline-variant: var(--ref-palette-neutral-30);

  /* Helper RGB values for rgba() usage */
  --sys-color-primary-rgb: 180, 216, 174;
  /* Sage green */
  --sys-color-secondary-rgb: 224, 159, 125;
  /* Terracotta RGB */
  --sys-color-tertiary-rgb: 240, 196, 25;
  /* Wattle Gold */
  --sys-color-surface-rgb: 18, 18, 18;
  --sys-color-on-surface-rgb: 230, 225, 229;

  /* Navigation State Colors (Semantic) */
  --sys-color-nav-active-container: var(--ref-palette-primary-80);
  /* Sage green for active nav pill */
  --sys-color-on-nav-active: var(--ref-palette-primary-20);
  /* Dark green text on active nav */
  --sys-color-nav-inactive: var(--ref-palette-neutral-70);
  /* Muted text for inactive nav */

  /* ========================================================================
   * MOTION (M3 Expressive Physics)
   * Three-Tier Architecture: Reference → System → Component
   * ======================================================================== */

  /* ========================================================================
   * REFERENCE LAYER: Spring Physics Constants
   * Formula: Damping = 2 × ζ × √(mass × stiffness)
   * M3 Expressive uses ζ < 1 (underdamped) for "bounce"
   * ======================================================================== */

  /* Expressive Default (ζ = 0.6, stiffness = 500) */
  --md-ref-motion-spring-stiffness-default: 500;
  --md-ref-motion-spring-damping-default: 27;
  --md-ref-motion-spring-mass-default: 1.0;

  /* Expressive Slow (ζ = 0.6, stiffness = 300) */
  --md-ref-motion-spring-stiffness-slow: 300;
  --md-ref-motion-spring-damping-slow: 21;
  --md-ref-motion-spring-mass-slow: 1.0;

  /* Expressive Fast (ζ = 0.6, stiffness = 1400) */
  --md-ref-motion-spring-stiffness-fast: 1400;
  --md-ref-motion-spring-damping-fast: 45;
  --md-ref-motion-spring-mass-fast: 1.0;

  /* Standard (No Bounce - ζ = 1.0, stiffness = 800) */
  --md-ref-motion-spring-stiffness-standard: 800;
  --md-ref-motion-spring-damping-standard: 57;
  --md-ref-motion-spring-mass-standard: 1.0;

  /* Durations (CSS Fallback) */
  --sys-motion-duration-short-1: 50ms;
  --sys-motion-duration-short-2: 100ms;
  --sys-motion-duration-medium-1: 250ms;
  --sys-motion-duration-medium-2: 400ms;
  --sys-motion-duration-long-1: 500ms;
  --sys-motion-duration-long-2: 600ms;
  --sys-motion-duration-extra-long-1: 700ms;
  --sys-motion-duration-extra-long-4: 1000ms;

  /* Easing curves (CSS Fallback - Deprecated for Expressive Components) */
  --sys-motion-easing-linear: cubic-bezier(0, 0, 1, 1);
  --sys-motion-easing-standard: cubic-bezier(0.2, 0, 0, 1);
  --sys-motion-easing-standard-accelerate: cubic-bezier(0.3, 0, 1, 1);
  --sys-motion-easing-standard-decelerate: cubic-bezier(0, 0, 0, 1);

  /* Expressive Easing (Legacy - Use Framer Motion Springs Instead) */
  --sys-motion-easing-emphasized: cubic-bezier(0.2, 0, 0, 1);
  --sys-motion-easing-emphasized-accelerate: cubic-bezier(0.3, 0, 0.8, 0.15);
  --sys-motion-easing-emphasized-decelerate: cubic-bezier(0.05, 0.7, 0.1, 1.0);

  /* True Spring Physics Approximations (Legacy) */
  --sys-motion-easing-expressive-spring: cubic-bezier(0.175, 0.885, 0.32, 1.275);
  --sys-motion-easing-expressive-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);

  /* ========================================================================
   * TYPOGRAPHY (M3 Expressive)
   * Font: Flora & Fauna Stack (Gum Tree, Vine, Bush Stone)
   * ======================================================================== */

  --sys-type-gum-tree: 'Plus Jakarta Sans', sans-serif;
  --sys-type-vine: 'Caveat', cursive;
  --sys-type-bush-stone: 'Fredoka', sans-serif;

  --sys-type-display-family: var(--sys-type-gum-tree);
  --sys-type-body-family: var(--sys-type-gum-tree);
  --sys-type-mono-family: 'JetBrains Mono', monospace;

  /* Extreme Weights */
  --sys-type-weight-thin: 100;
  --sys-type-weight-light: 300;
  --sys-type-weight-regular: 400;
  --sys-type-weight-medium: 500;
  --sys-type-weight-bold: 700;
  --sys-type-weight-heavy: 800;
  --sys-type-weight-black: 900;

  /* M3 Expressive Semantic Weights */
  --sys-type-weight-display: 900;
  /* Headlines - Extreme Black */
  --sys-type-weight-body: 400;
  /* Body text - Regular */
  --sys-type-weight-caption: 900;
  /* Micro-copy - High impact labels */
  --sys-type-weight-editorial: 100;
  /* Editorial moments - Ultra-light elegance */

  /* ========================================================================
   * REFERENCE LAYER: Variable Font Axes (Parametric Typography)
   * ======================================================================== */

  --md-ref-type-axes-hero: 'wght' 900, 'wdth' 150, 'GRAD' 0, 'XTRA' 468, 'opsz' 24;
  --md-ref-type-axes-data: 'wght' 500, 'wdth' 110, 'GRAD' 0, 'XTRA' 468, 'opsz' 8;
  --md-ref-type-axes-ai: 'wght' 450, 'wdth' 92, 'GRAD' 20, 'XTRA' 468, 'opsz' 16;
  --md-ref-type-axes-authoritative: 'wght' 800, 'wdth' 120, 'XTRA' 468, 'GRAD' 0, 'opsz' 48;
  --md-ref-type-axes-default: 'wght' 400, 'wdth' 100, 'GRAD' 0, 'XTRA' 468, 'opsz' 16;

  /* ========================================================================
   * SYSTEM LAYER: Semantic Typography Axes
   * ======================================================================== */

  --md-sys-type-axes-hero: var(--md-ref-type-axes-hero);
  --md-sys-type-axes-data: var(--md-ref-type-axes-data);
  --md-sys-type-axes-ai: var(--md-ref-type-axes-ai);
  --md-sys-type-axes-authoritative: var(--md-ref-type-axes-authoritative);
  --md-sys-type-axes-default: var(--md-ref-type-axes-default);

  /* Legacy Parametric Axes (Deprecated - Use md-sys-type-axes-* instead) */
  --sys-type-axes-hero: var(--md-sys-type-axes-hero);
  --sys-type-axes-data: var(--md-sys-type-axes-data);
  --sys-type-axes-ai: var(--md-sys-type-axes-ai);
  --sys-type-axes-authoritative: var(--md-sys-type-axes-authoritative);

  /* ========================================================================
   * PARAMETRIC PAIRING: Shape State → Typography Axes
   * When shape morphs, typography axes MUST adjust for optical balance
   * CRITICAL: wght (font-weight) stays constant to prevent layout reflow
   * ======================================================================== */

  /* Rest State (No Morph) */
  --md-sys-type-morph-rest: 'wght' 400, 'wdth' 100, 'GRAD' 0;

  /* Pebble Morph State */
  --md-sys-type-morph-pebble: 'wght' 400, 'wdth' 110, 'GRAD' 150;

  /* Leaf Morph State */
  --md-sys-type-morph-leaf: 'wght' 400, 'wdth' 105, 'GRAD' 100;

  /* Gem Morph State */
  --md-sys-type-morph-gem: 'wght' 400, 'wdth' 100, 'GRAD' 200;

  /* Scales */
  --sys-type-display-large-size: 57px;
  --sys-type-display-large-line-height: 64px;
  --sys-type-display-large-tracking: -0.25px;

  --sys-type-display-medium-size: 45px;
  --sys-type-display-medium-line-height: 52px;

  --sys-type-display-small-size: 36px;
  --sys-type-display-small-line-height: 44px;

  --sys-type-headline-large-size: 32px;
  --sys-type-headline-large-line-height: 40px;

  --sys-type-title-large-size: 22px;
  --sys-type-title-large-line-height: 28px;

  --sys-type-body-large-size: 16px;
  --sys-type-body-large-line-height: 24px;

  --sys-type-body-medium-size: 14px;
  --sys-type-body-medium-line-height: 20px;

  /* ========================================================================
   * SPACING (Grid System)
   * Based on M3 4px/8px grid system
   * ======================================================================== */

  --sys-space-0: 0;
  --sys-space-xs: 4px;
  --sys-space-sm: 8px;
  --sys-space-md: 16px;
  --sys-space-lg: 24px;
  --sys-space-xl: 32px;
  --sys-space-2xl: 48px;
  --sys-space-3xl: 64px;

  /* ========================================================================
   * SHAPE & ELEVATION (M3 Expressive)
   * Three-Tier Architecture: Reference → System → Component
   * ======================================================================== */

  /* ========================================================================
   * REFERENCE LAYER: Polygon-Based Shapes (Path-Based)
   * These are organic, physics-inspired shapes that replace generic pills
   * ======================================================================== */

  /* 1. The Pebble (Organic / Friendly) */
  --md-ref-shape-pebble: polygon(8% 20%, 28% 8%, 48% 8%, 68% 8%, 88% 20%, 96% 40%, 96% 60%, 88% 80%, 68% 92%, 48% 92%, 28% 92%, 8% 80%, 4% 60%, 4% 40%);

  /* 2. The Leaf (Asymmetric / Growth) */
  --md-ref-shape-leaf: polygon(5% 15%, 25% 5%, 45% 5%, 65% 5%, 85% 15%, 95% 35%, 95% 55%, 85% 75%, 65% 95%, 45% 95%, 25% 95%, 5% 75%, 5% 55%, 5% 35%);

  /* 3. The Gem (Sharp / Highlight) */
  --md-ref-shape-gem: polygon(20% 0%, 50% 10%, 80% 0%, 95% 30%, 90% 60%, 70% 85%, 50% 100%, 30% 85%, 10% 60%, 5% 30%);

  /* 4. The Burst (Editorial / Star) */
  --md-ref-shape-burst: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);

  /* Reference Corner Radii (For Simple Shapes) */
  --md-ref-shape-corner-sm: 8px;
  --md-ref-shape-corner-md: 12px;
  --md-ref-shape-corner-lg: 16px;
  --md-ref-shape-corner-xl: 24px;
  --md-ref-shape-corner-2xl: 28px;
  --md-ref-shape-corner-3xl: 32px;

  /* ========================================================================
   * SYSTEM LAYER: Semantic Shape Roles
   * Map Reference shapes to semantic purposes
   * ======================================================================== */

  --md-sys-shape-card: var(--md-ref-shape-pebble);
  --md-sys-shape-button: var(--md-ref-shape-corner-lg);
  --md-sys-shape-hero: var(--md-ref-shape-leaf);
  --md-sys-shape-badge: var(--md-ref-shape-gem);
  --md-sys-shape-editorial: var(--md-ref-shape-burst);

  /* Legacy Organic Archetypes (Border-Radius Based - Deprecated) */
  --sys-shape-leaf: 32px 12px 32px 12px;
  --sys-shape-tech: 24px 4px 24px 20px;
  --sys-shape-pebble: 20px 20px 32px 32px;
  --sys-shape-gem: 40px 8px 40px 8px;
  --sys-shape-flow-l: 32px 12px 12px 12px;
  --sys-shape-flow-r: 12px 32px 12px 12px;

  /* System Shape Scale (Simple Corners) */
  --sys-shape-corner-details: 4px;
  --sys-shape-corner-small: 8px;
  --sys-shape-corner-medium: 12px;
  --sys-shape-corner-large: 16px 8px 16px 8px;
  --sys-shape-corner-extra-large: 28px 12px 28px 12px;
  --sys-shape-corner-full: 9999px;

  /* Colored Shadows (Depth) */
  --sys-elevation-level1: 0 1px 2px rgba(0, 0, 0, 0.3), 0 1px 3px 1px rgba(0, 0, 0, 0.15);
  --sys-elevation-level2: 0 1px 2px rgba(0, 0, 0, 0.3), 0 2px 6px 2px rgba(0, 0, 0, 0.15);
  --sys-elevation-level3: 0 4px 8px 3px rgba(0, 0, 0, 0.15), 0 1px 3px rgba(0, 0, 0, 0.3);
  --sys-elevation-level4: 0 6px 10px 4px rgba(0, 0, 0, 0.15), 0 2px 3px rgba(0, 0, 0, 0.3);
  --sys-elevation-level5: 0 8px 12px 6px rgba(0, 0, 0, 0.15), 0 4px 4px rgba(0, 0, 0, 0.3);

  /* Glows */
  --sys-elevation-glow-primary: 0 0 15px rgba(160, 197, 141, 0.4);
  --sys-elevation-glow-secondary: 0 0 15px rgba(253, 207, 196, 0.4);
}